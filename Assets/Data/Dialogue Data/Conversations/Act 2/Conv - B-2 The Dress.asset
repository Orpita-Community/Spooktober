      characters: 0
      cast: []
      closeUp: 0
      closeUpImage: {fileID: 0}
    id: l14
  - speaker: {fileID: 11400000, guid: 5ff72c6971643b146980da569faf3c4c, type: 2}
    expression: 0
    text: Because fixing something doesn't mean pretending it was never broken.
    style: 0
    effects: []
    stage:
      transition: 0
      background: {fileID: 0}
      characters: 0
      cast: []
      closeUp: 0
      closeUpImage: {fileID: 0}
    id: l15
  - speaker: {fileID: 11400000, guid: 2a43c1c0eff9fed4081428b339fe3cf1, type: 2}
    expression: 11
    text: That's weird.
    style: 0
    effects: []
    stage:
      transition: 0
      background: {fileID: 0}
      characters: 0
      cast: []
      closeUp: 0
      closeUpImage: {fileID: 0}
    id: l16
  - speaker: {fileID: 11400000, guid: 5ff72c6971643b146980da569faf3c4c, type: 2}
    expression: 1
    text: Probably.
    style: 0
    effects: []
    stage:
      transition: 0
      background: {fileID: 0}
      characters: 0
      cast: []
      closeUp: 0
      closeUpImage: {fileID: 0}
