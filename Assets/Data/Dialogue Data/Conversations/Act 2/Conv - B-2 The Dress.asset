  - speaker: {fileID: 11400000, guid: 2a43c1c0eff9fed4081428b339fe3cf1, type: 2}
    expression: 11
    text: Why don't you use new fabric?
    style: 0
    effects: []
    stage:
      transition: 0
      background: {fileID: 0}
      characters: 0
      cast: []
      closeUp: 0
      closeUpImage: {fileID: 0}
