  m_Script: {fileID: 11500000, guid: 22ff450188ab97f499b760304ec457d0, type: 3}
  m_Name: Conv - 01 Shop Intro
  m_EditorClassIdentifier: Spooktober::Dialogue_ConversationSO
  saveID: 6d85940a1ed241c4ab7e6555d5aaf241
  chapter: {fileID: 11400000, guid: 003fbbcc9207df9499673ad4849480f7, type: 2}
  autosaveOnStart: 1
  lines:
  - speaker: {fileID: 0}
    expression: 0
    text: Rain hammers the windows of Alexander's Costume Emporium. The sign on the
      door still says <i>OPEN</i>.
    effects: []
    id: l01
  - speaker: {fileID: 11400000, guid: e4e3a731f62a8fa46b2ecd1b5e15ca59, type: 2}
    expression: 0
    text: ...He really sat at that sewing machine every single night?
    effects: []
    id: l02
  - speaker: {fileID: 11400000, guid: e4e3a731f62a8fa46b2ecd1b5e15ca59, type: 2}
    expression: 2
    text: One year gone, Uncle. The shop still smells like you.
    effects: []
    id: l03
  - speaker: {fileID: 0}
    expression: 0
    text: The bell above the door rings. Nobody should be out in this weather.
    effects:
    - variable: {fileID: 11400000, guid: d68c00d806004494fa49638d0e8e9045, type: 2}
      operation: 0
      value: 2245
    id: l04
  endType: 2
  choices: []
  branches: []
  defaultNext: {fileID: 11400000, guid: 99e5190c6870d4f4593ac4cb7a015c35, type: 2}
