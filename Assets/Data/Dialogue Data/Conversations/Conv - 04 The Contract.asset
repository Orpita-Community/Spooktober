  autosaveOnStart: 1
  lines:
  - speaker: {fileID: 0}
    expression: 0
    text: Vance is gone. On the counter lies an old contract, signed in something
      darker than ink.
    effects:
    - variable: {fileID: 11400000, guid: d68c00d806004494fa49638d0e8e9045, type: 2}
      operation: 0
      value: 2347
    - variable: {fileID: 11400000, guid: 0001be92272b84e4b8cf5dc0d353481a, type: 2}
      operation: 0
      value: 1
    id: l01
  - speaker: {fileID: 11400000, guid: e4e3a731f62a8fa46b2ecd1b5e15ca59, type: 2}
    expression: 5
    text: October 31st, 11:59 PM... That's the exact minute Uncle Alexander disappeared.
    effects: []
    id: l02
  - speaker: {fileID: 11400000, guid: e4e3a731f62a8fa46b2ecd1b5e15ca59, type: 2}
    expression: 4
    text: And the line for the next signature already has my name on it.
    effects: []
    id: l03
  endType: 1
  choices:
  - text: Remember him fixing costumes for kids who couldn't pay.
    requirements: []
    showWhenLocked: 0
    effects:
    - variable: {fileID: 11400000, guid: ea36ca2800b75c246925d1faa2afac28, type: 2}
