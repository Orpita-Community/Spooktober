  lines:
  - speaker: {fileID: 11400000, guid: e97ac13d3e46c134e982a04a88346827, type: 2}
    expression: 6
    text: Good evening. You must be the nephew.
    effects: []
    id: l01
  - speaker: {fileID: 11400000, guid: e4e3a731f62a8fa46b2ecd1b5e15ca59, type: 2}
    expression: 4
    text: We're closed. How did you even get in?
    effects: []
    id: l02
  - speaker: {fileID: 11400000, guid: e97ac13d3e46c134e982a04a88346827, type: 2}
    expression: 0
    text: Your uncle never locked the door for me. I believe you have something that
      belongs to me.
    effects: []
    id: l03
  endType: 1
  choices:
  - text: Give him the costume.
    requirements: []
    showWhenLocked: 0
    effects:
    - variable: {fileID: 11400000, guid: ea36ca2800b75c246925d1faa2afac28, type: 2}
      operation: 1
      value: 1
    reactionSpeaker: {fileID: 0}
    reactionExpression: 0
    reactionLine: 
    next: {fileID: 11400000, guid: 59dd38cefddbf2841bb2bf812e023557, type: 2}
    id: c01
  - text: What about the deposit he paid?
    requirements: []
    showWhenLocked: 0
    effects:
    - variable: {fileID: 11400000, guid: ef64d149c1a38a04bbc1893a157619af, type: 2}
      operation: 1
      value: 1
    reactionSpeaker: {fileID: 0}
    reactionExpression: 0
    reactionLine: 
    next: {fileID: 11400000, guid: 8beb60f99c4bc7e4c8f825dae4c7e32b, type: 2}
    id: c02
  - text: Get out of my uncle's shop, old man.
    requirements: []
    showWhenLocked: 0
    effects:
    - variable: {fileID: 11400000, guid: ef64d149c1a38a04bbc1893a157619af, type: 2}
      operation: 1
      value: 1
    reactionSpeaker: {fileID: 0}
    reactionExpression: 3
    reactionLine: Such manners. Alexander would be <b>so</b> disappointed in you.
    next: {fileID: 11400000, guid: acc3f1d67400582468261301ed2f73d9, type: 2}
    id: c03
  - text: Tell him what the contract says.
    requirements:
    - variable: {fileID: 11400000, guid: 0001be92272b84e4b8cf5dc0d353481a, type: 2}
      comparison: 0
      compareTo: 0
      constant: 1
      otherVariable: {fileID: 0}
